# Copiez ce fichier en .env (jamais commité) et remplissez les valeurs.
# Sur Render, saisissez les mêmes variables dans Environment.

# Origines autorisées (format JSON, sans "/" final ni chemin)
ALLOWED_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500","https://grayhacked.github.io"]

# Clé API Brevo (SMTP & API > Clés API). Vide = aucun email envoyé.
BREVO_API_KEY=

# Adresse expéditrice validée dans Brevo
CONTACT_FROM=

# Destinataire des messages
CONTACT_TO=sannonjeanduckens@gmail.com
